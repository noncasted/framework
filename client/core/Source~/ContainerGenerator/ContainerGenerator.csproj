<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>ContainerGenerator</RootNamespace>
    <AssemblyName>ContainerGenerator</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);RS1038;RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unity runs Roslyn 4.x: the generator pins the 4.3.0 API. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" VersionOverride="3.3.4" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ContainerGenerator.Verify" />
  </ItemGroup>
  <!-- Only a Release build replaces the committed analyzer: building the solution (Debug) leaves it alone.
       -p:SkipAnalyzersCopy=true builds and verifies without the copy: a check next to a running Unity on the same tree
       (run-tests.sh of a game) must not change its analyzer, Unity would request a compilation in the middle of the run. -->
  <Target Name="CopyToAnalyzers" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(SkipAnalyzersCopy)' != 'true'">
    <PropertyGroup>
      <UnityPluginsDir>$(MSBuildProjectDirectory)/../../Analyzers</UnityPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(UnityPluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityPluginsDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
