{
  "description": "aggressive-assetbundles with the switches of aggressive-lean: the coverage of the AssetBundle loading for the stripping of engine code",
  "parts": [
    "assetbundles"
  ],
  "packages": {
    "com.unity.modules.accessibility": null,
    "com.unity.modules.adaptiveperformance": null,
    "com.unity.modules.ai": null,
    "com.unity.modules.androidjni": null,
    "com.unity.modules.animation": null,
    "com.unity.modules.director": null,
    "com.unity.modules.particlesystem": null,
    "com.unity.modules.physics": null,
    "com.unity.modules.physics2d": null,
    "com.unity.modules.physicscore2d": null,
    "com.unity.modules.screencapture": null,
    "com.unity.modules.tilemap": null,
    "com.unity.modules.timelinefoundation": null,
    "com.unity.modules.umbra": null,
    "com.unity.modules.unityanalytics": null,
    "com.unity.modules.unitywebrequest": null,
    "com.unity.modules.unitywebrequestassetbundle": null,
    "com.unity.modules.unitywebrequestaudio": null,
    "com.unity.modules.unitywebrequesttexture": null,
    "com.unity.modules.unitywebrequestwww": null,
    "com.unity.modules.video": null
  },
  "strip": [
    "base.txt",
    "aggressive.txt",
    "physics2d.txt",
    "invariant.txt"
  ],
  "linkerArgs": "--dotnet-runtime-feature=InvariantGlobalization,UseSystemResourceKeys",
  "dropData": [
    "Il2CppData/Icu/icudt.dat"
  ],
  "profile": {
    "il2cppCodeGeneration": 1,
    "gcIncremental": 0,
    "additionalIl2CppArgs": "--compiler-flags=-DIL2CPP_SYSTEM_GLOBALIZATION_INVARIANT=1"
  }
}