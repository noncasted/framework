#!/usr/bin/env python3
# A stand-in of `ssh -N -L <local>:127.0.0.1:<remote> ... <alias>` for the tests (DEPLOY_SSH): listens on every local port
# and forwards it to 127.0.0.1:$FAKE_SSH_<remote>, the fake store of that remote port. Writes its arguments to $FAKE_SSH_LOG
# and "closed" when terminated. FAKE_SSH_FAIL: print it to stderr and exit 255, as ssh does when it cannot connect.
import os
import signal
import socket
import sys
import threading


def pipe(source, target):
    try:
        while data := source.recv(65536):
            target.sendall(data)
    except OSError:
        pass
    finally:
        for end in (source, target):
            try:
                end.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass


def serve(listener, remote_port):
    while True:
        client, _ = listener.accept()
        upstream = socket.create_connection(("127.0.0.1", remote_port))
        threading.Thread(target=pipe, args=(client, upstream), daemon=True).start()
        threading.Thread(target=pipe, args=(upstream, client), daemon=True).start()


def main():
    arguments = sys.argv[1:]
    log = os.environ["FAKE_SSH_LOG"]

    with open(log, "a") as file:
        file.write(" ".join(arguments) + "\n")

    if os.environ.get("FAKE_SSH_FAIL"):
        print(os.environ["FAKE_SSH_FAIL"], file=sys.stderr)
        sys.exit(255)

    def closed(*_):
        with open(log, "a") as file:
            file.write("closed\n")
        os._exit(0)

    signal.signal(signal.SIGTERM, closed)

    for index, argument in enumerate(arguments):
        if argument == "-L":
            local, _, remote = arguments[index + 1].split(":")
            listener = socket.socket()
            listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            listener.bind(("127.0.0.1", int(local)))
            listener.listen()
            threading.Thread(target=serve, args=(listener, int(os.environ[f"FAKE_SSH_{remote}"])), daemon=True).start()

    signal.pause()


if __name__ == "__main__":
    main()
