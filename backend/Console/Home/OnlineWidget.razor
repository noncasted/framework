@using Cluster.Deploy
@using Cluster.Monitoring.Online
@using Console.Infrastructure.Online
@using global::Common.Extensions
@using global::Internal
@inherits UiComponent

<div class="rounded-lg border bg-card p-3 flex flex-col gap-3">
    <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3 cursor-pointer" @onclick="@(() => Navigation.NavigateTo(ConsoleConstants.Pages.Online))">
            <div class="rounded-lg bg-green-500/15 p-2">
                <LucideIcon Name="activity" Size="18" class="text-green-400"/>
            </div>
            <div>
                <h2 class="text-sm font-semibold">Online</h2>
                <p class="text-xs text-muted-foreground">Unique users online right now</p>
            </div>
        </div>

        <div class="text-right">
            <div class="text-2xl font-bold leading-none">@_data.Current</div>
            <div class="text-xs text-muted-foreground">@(_data.UpdatedAt == default ? "no data" : OnlinePeriodFormat.Updated(_data.UpdatedAt))</div>
        </div>
    </div>

    @if (_data.UpdatedAt == default)
    {
        return;
    }

    <div class="grid grid-cols-3 gap-2">
        <OnlineStatTile Label="Online now" Value="@_data.Current"/>
        <OnlineStatTile Label="Peak in view" Value="@_periods.Max(period => period.Peak)"/>
        <OnlineStatTile Label="@(_scale == OnlineScale.Hours ? "Unique today" : "Unique 30 days")"
                        Value="@(_scale == OnlineScale.Hours ? _data.Days[^1].UniqueUsers : _data.UniqueLast30Days)"/>
    </div>

    <OnlineChart Periods="@_periods" Scale="@_scale" Height="125px"/>

    <OnlineScaleSwitch Value="@_scale" ValueChanged="SetScale"/>
</div>

@code {
    [Inject] private IDeploymentState<OnlineStatsLiveData> State { get; set; } = null!;
    [Inject] private IConsoleNavigation Navigation { get; set; } = null!;

    // The periods of the chart: a day of hours, two weeks of days.
    private const int _hoursInView = 24;
    private const int _daysInView = 14;

    private OnlineStatsLiveData _data = new();
    private OnlineScale _scale = OnlineScale.Hours;
    private IReadOnlyList<OnlinePeriod> _periods = [];

    protected override Task OnSetup(IReadOnlyLifetime lifetime)
    {
        State.View(lifetime, data =>
        {
            _data = data;
            _periods = InView();
            InvokeAsync(StateHasChanged).NoAwait();
        });

        return Task.CompletedTask;
    }

    private void SetScale(OnlineScale scale)
    {
        _scale = scale;
        _periods = InView();
    }

    private IReadOnlyList<OnlinePeriod> InView()
    {
        return OnlinePeriodFormat.Last(_data, _scale, _scale == OnlineScale.Hours ? _hoursInView : _daysInView);
    }
}
